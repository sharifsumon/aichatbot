# Copy to .env and fill in. Never commit .env.

# --- Infrastructure ---
POSTGRES_PASSWORD=agently
DATABASE_URL=postgres://agently:agently@localhost:5432/agently
REDIS_URL=redis://localhost:6379

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Encrypts page access tokens and other secrets at rest.
ENCRYPTION_KEY=

# --- Public URLs ---
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000

# --- Meta (Facebook Messenger + page comments) ---
META_APP_ID=
META_APP_SECRET=
# Any random string; paste the same value into the Meta app's webhook settings.
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# --- AI provider ---
# Any OpenAI-compatible chat completions API: a cheap hosted model now,
# a self-hosted model (vLLM, Ollama) later by changing these three lines.
AI_BASE_URL=
AI_API_KEY=
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=
# Must match the vector column size in packages/db (1024).
AI_EMBEDDING_DIMENSIONS=1024
# Cost per 1M tokens in USD, used for usage records and the admin AI cost view.
AI_INPUT_COST_PER_MTOK=0
AI_OUTPUT_COST_PER_MTOK=0

# --- VPS only: domains Caddy serves with automatic HTTPS ---
WEB_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ADMIN_DOMAIN=admin.example.com
